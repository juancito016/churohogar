# Rutas de la SPA. Cloudflare Pages solo entra en modo SPA si NO existe
# un 404.html de nivel superior; como public/404.html si existe, hay que
# declarar a mano las rutas que deben cargar la aplicacion.
# Cualquier otra ruta cae en /404.html con HTTP 404 real.
/ /index.html 200
/admin /index.html 200
/admin/ /index.html 200
/contacto /index.html 200
/contacto/ /index.html 200
/guia /index.html 200
/guia/ /index.html 200
/quienes-somos /index.html 200
/quienes-somos/ /index.html 200
/inmueble/* /index.html 200
